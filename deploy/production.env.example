# Production — siber.cloudnira.com
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

POSTGRES_USER=siber
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=siber

SECRET_KEY=CHANGE_ME_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_PLATFORM_ADMIN_EMAIL=admin@example.com
INITIAL_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_20_PLUS_CHARACTER_PASSWORD

CORS_ORIGINS=https://siber.cloudnira.com
NEXT_PUBLIC_API_URL=https://siber.cloudnira.com
TRUSTED_PROXY_IPS=127.0.0.1
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_HOUR=20
SCAN_RATE_LIMIT_PER_HOUR=20
SCAN_CONCURRENCY_LIMIT=1
SCAN_DAILY_QUOTA=5
NOTIFICATIONS_PROVIDER=noop
# SMTP (Ionos — direct from SIBER containers; authorized sender required)
SMTP_ENABLED=true
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@wolkeshopping.de
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="SIBER <info@wolkeshopping.de>"
FRONTEND_PUBLIC_URL=https://siber.cloudnira.com
FRONTEND_PUBLIC_URL=https://siber.cloudnira.com
MOBILE_MAX_UPLOAD_BYTES=104857600
MOBILE_ANALYSIS_TIMEOUT_SECONDS=600
MOBILE_ANALYSIS_MEMORY_LIMIT=768m
MOBILE_ANALYSIS_CPUS=1.0
MOBILE_ANALYSIS_PIDS_LIMIT=128
